package components

templ Loader(id string) {
    // The outer div fills the available space of the parent
    <div id={ id } class="htmx-indicator flex h-full w-full items-center justify-center p-2">
        // This inner div scales based on the smallest dimension of its parent
        <div class="relative aspect-square h-full max-h-12 max-w-12 flex items-center justify-center">
            <div class="h-1.5 w-1.5 rounded-full bg-white z-10"></div>
            
            <div class="absolute inset-0 animate-ping rounded-full bg-white opacity-75"></div>
            <div class="absolute inset-0 animate-[ping_1.5s_linear_infinite_0.5s] rounded-full bg-white opacity-40"></div>
        </div>
    </div>
}
